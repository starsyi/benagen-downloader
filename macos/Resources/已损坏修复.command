#!/bin/bash
#
# 已损坏修复 —— 解除 macOS 对本应用的隔离拦截
#
# 什么时候用：双击应用图标时提示
#               「"BenagenDownloader"已损坏，无法打开。你应该将它移到废纸篓。」
#             或「无法打开，因为来自身份不明的开发者」。
#
# 怎么用：**双击本文件**。
#         ⚠️ 万一双击本文件也被拦下（本文件自己也被打了隔离属性），
#            把本文件的内容**整段复制**进「终端」再回车 —— 一样能跑，
#            脚本会自己去挂载的安装盘里找应用（见下面第 1 步的兜底）。
#
# 它做什么（全在本机完成，不联网）：
#   1. 找到 BenagenDownloader.app —— 优先本文件旁边（挂载的安装盘里），
#      其次 /Applications 里已经装好的那份
#   2. 用 ditto 装进 /Applications
#   3. 清掉 com.apple.quarantine（隔离属性）—— **这一步才是真正解决问题的那一下**
#   4. 复查属性确实没了，然后启动
#
# 它**不做**什么（有意为之，两条都写清理由）：
#   · **不动系统 Gatekeeper。** 网上一些修复工具会执行 `sudo spctl --master-disable`，
#     那是把**整台机器**的安全闸门永久关掉、且不会自己恢复。
#     它不只是"代价太大"，而且是**没用的** —— 实测（两台同机、除隔离属性外
#     完全相同的假应用）：Gatekeeper 处在关闭状态时，带隔离属性的那个**照样起不来**，
#     不带属性的那个正常起来。拦截发生在 `spctl` 管不到的另一层，
#     真正管用的只有清掉属性这一下。
#   · **不重新签名。** `codesign --force --deep` 用在本应用这种**本来就没有签名**
#     的包上，一旦中途失败会留下一个签名残缺的包，那是比"没签名"更糟的状态
#     （在 Apple 芯片的机器上直接起不来）。Apple 也已弃用 `--deep`。
#
# 环境变量（一般不用管）：
#   BENAGEN_APP_DEST —— 安装目标目录，默认 /Applications

set -u

APP_NAME="BenagenDownloader.app"
DEST_DIR="${BENAGEN_APP_DEST:-/Applications}"

# ---------------------------------------------------------------------------
# 输出
# ---------------------------------------------------------------------------
# 只在真终端里上色；被重定向或走管道时给纯文本，免得日志里全是转义码。
if [ -t 1 ]; then
  C_R=$'\033[31m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_B=$'\033[1m'; C_N=$'\033[0m'
else
  C_R=""; C_G=""; C_Y=""; C_B=""; C_N=""
fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "${C_G}" "${C_N}" "$*"; }
warn() { printf '%s!%s %s\n' "${C_Y}" "${C_N}" "$*"; }
die()  { printf '%s✗%s %s\n' "${C_R}" "${C_N}" "$*" >&2; exit 1; }

# 只有写系统目录、或改 root 属主的文件时才需要密码。
# 用户自己拷进去的那份不需要 —— 所以先不带 sudo 试一遍，失败再问，
# 不无谓地弹密码框。
need_admin() {
  say ""
  say "${C_B}这一步需要管理员权限，请输入开机密码（输入时不显示）${C_N}"
  sudo "$@"
}

say ""
say "${C_B}Benagen 数据下载工具 —— 已损坏修复${C_N}"
say ""

# ---------------------------------------------------------------------------
# 1. 找到安装包
# ---------------------------------------------------------------------------
# 先看本文件旁边。正常用法是把安装盘挂上、双击本文件，应用就在同一层。
SELF_DIR=""
if [ -n "${BASH_SOURCE[0]:-}" ] && [ -f "${BASH_SOURCE[0]}" ]; then
  SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
fi

SRC_APP=""
if [ -n "${SELF_DIR}" ] && [ -d "${SELF_DIR}/${APP_NAME}" ]; then
  SRC_APP="${SELF_DIR}/${APP_NAME}"
  ok "在安装盘里找到：${SRC_APP}"
else
  # 兜底：本文件被整段贴进终端时 SELF_DIR 为空（正是"双击本文件也打不开"那种情形）。
  # 安装盘还挂着的话，去挂载卷里找一圈。
  #
  # ⚠️ 可能有**不止一张**盘挂着（上一次下载的那张忘了卸载，实测很常见）。
  #    这种情况必须说出来 —— 静默挑第一张装上去，用户只会看到一句"已安装"，
  #    却无从知道装的是哪一张、是不是自己刚下的那个版本。
  VOL_HITS=""
  VOL_N=0
  for vol in /Volumes/*/; do
    [ -d "${vol}" ] || continue
    if [ -d "${vol}${APP_NAME}" ]; then
      VOL_HITS="${VOL_HITS}${vol}${APP_NAME}
"
      VOL_N=$((VOL_N + 1))
      [ -n "${SRC_APP}" ] || SRC_APP="${vol}${APP_NAME}"
    fi
  done
  if [ -n "${SRC_APP}" ]; then
    ok "在挂载的安装盘里找到：${SRC_APP}"
  fi
  if [ "${VOL_N}" -gt 1 ]; then
    warn "注意：有 ${VOL_N} 张已挂载的盘里都装着这个应用，上面用的是**第一张** ——"
    printf '%s' "${VOL_HITS}" | sed 's/^/      /'
    say "      如果装错了版本，把多余的盘卸载掉，再重跑一次本脚本。"
  fi
fi

TARGET="${DEST_DIR}/${APP_NAME}"

# ---------------------------------------------------------------------------
# 2. 装进目标目录
# ---------------------------------------------------------------------------
if [ -n "${SRC_APP}" ]; then
  # ⚠️ 安装盘是**只读**的 —— 属性改不了盘里那份，只能先拷出来再改。
  #    这也正是"必须装一份到本机"的原因，不是多此一举。
  if [ -e "${TARGET}" ]; then
    warn "${TARGET} 已经存在，将用这一次下载的版本替换它"
    rm -rf "${TARGET}" 2>/dev/null \
      || need_admin rm -rf "${TARGET}" \
      || die "删不掉旧的 ${TARGET}，上面的报错说明了原因。"
  fi
  mkdir -p "${DEST_DIR}" 2>/dev/null \
    || need_admin mkdir -p "${DEST_DIR}" \
    || die "建不了目录 ${DEST_DIR}。"
  # ⚠️ 用 ditto 而不是 cp -R：cp 拷 .app 会破坏包结构与扩展属性，
  #    这是拷 mac 应用包最经典的一个坑。
  ditto "${SRC_APP}" "${TARGET}" \
    || need_admin ditto "${SRC_APP}" "${TARGET}" \
    || die "拷贝到 ${TARGET} 失败，上面的报错说明了原因。"
  ok "已安装到 ${TARGET}"
else
  if [ ! -d "${TARGET}" ]; then
    say ""
    die "找不到 ${APP_NAME}。请确认本文件与它在**同一个安装盘**里，
    或者先把应用拖进「应用程序」目录，再双击本文件。"
  fi
  ok "安装盘里没有应用，改为直接修复已经装好的那份：${TARGET}"
fi

# ---------------------------------------------------------------------------
# 3. 清隔离属性（真正解决问题的那一步）
# ---------------------------------------------------------------------------
# Gatekeeper 只评估带 com.apple.quarantine 的物件。清掉这个属性，
# 系统就不再过问这个应用的签名，「已损坏」那条弹窗也就不会出现。
if xattr -dr com.apple.quarantine "${TARGET}" 2>/dev/null; then
  ok "已清除隔离属性"
elif need_admin xattr -dr com.apple.quarantine "${TARGET}"; then
  ok "已清除隔离属性"
else
  die "清除隔离属性失败，上面的报错说明了原因。"
fi

# ---------------------------------------------------------------------------
# 4. 复查 —— 属性真的没了才算数
# ---------------------------------------------------------------------------
# 本项目一贯的纪律是"跑完看结果"，不是"命令没报错"。
LEFT="$(xattr -r "${TARGET}" 2>/dev/null | grep -c 'com\.apple\.quarantine')" || LEFT=0
if [ "${LEFT:-0}" -eq 0 ]; then
  ok "复查通过：${TARGET} 下面已经没有隔离属性了"
else
  warn "复查发现还有 ${LEFT} 处带隔离属性 —— 可能没清干净，请把本窗口的内容截给我们。"
fi

# ---------------------------------------------------------------------------
# 5. 启动
# ---------------------------------------------------------------------------
say ""
say "正在启动 ${APP_NAME} …"
open "${TARGET}" 2>/dev/null || true

# ⚠️ **不能拿 `open` 的退出码当"启动成功"**（这一条是实测出来的，不是推测）：
#    在带着隔离属性时，`open` 照样返回 **0**，而应用根本没有起来 ——
#    拦截发生在 LaunchServices 那一层，连 `spctl --master-disable` 都拦不住它
#    （实测：同机两个一模一样的假应用，带属性的那个 `open` 返 0 却不运行，
#      不带的那个正常起来，而当时 Gatekeeper 是关着的）。
#    所以这里**看进程**，不看退出码。
STARTED=""
for _ in 1 2 3 4 5 6 7 8; do
  if pgrep -f "${TARGET}/Contents/MacOS/" >/dev/null 2>&1; then STARTED=yes; break; fi
  sleep 0.5
done
if [ -n "${STARTED}" ]; then
  ok "已启动"
else
  warn "启动命令发出去了，但**没有看到应用起来**"
fi

# ---------------------------------------------------------------------------
# 6. 万一还是不行
# ---------------------------------------------------------------------------
# ⚠️ 放行流程**按系统版本分**：那句流传很广的「右键 → 打开」从 macOS 15 起
#    已经失效（Apple 移除了那条路），照着错的那半念会让用户卡在
#    "我右键了但没这个选项"。这里按实际版本给。
OS_VER="$(sw_vers -productVersion 2>/dev/null || echo '未知')"
OS_MAJOR="${OS_VER%%.*}"
say ""
if [ "${OS_MAJOR}" -ge 15 ] 2>/dev/null; then
  say "如果打开时**仍然**提示「已损坏，无法打开」（你的系统是 macOS ${OS_VER}），请："
  say "  1. 先双击一次应用图标（会被拦下，这是正常的）"
  say "  2. 打开「系统设置 → 隐私与安全性」"
  say "  3. 往下找到「安全性」那一栏，里面有刚才那条拦截记录"
  say "  4. 点「仍要打开」，再确认一次"
  say "  ⚠️ 那个按钮只在尝试打开之后的约 1 小时内可用；隔太久就再双击一次，回到系统设置点。"
else
  say "如果打开时**仍然**提示「已损坏，无法打开」或「来自身份不明的开发者」"
  say "（你的系统是 macOS ${OS_VER}），请："
  say "  在访达里**右键**（或按住 Control 点击）${APP_NAME}"
  say "  → 选「打开」→ 在弹窗里再点一次「打开」"
fi
say ""
say "还是不行的话，请把本窗口里的内容截图发给我们。"
say ""

# 双击运行时窗口跑到结尾就会关掉，让人来不及看结论 —— 停一下等人按键。
# 只有在真终端里才停（走管道/重定向时 read 会立刻返回，不影响自动化）。
if [ -t 0 ]; then
  printf '\n%s按回车键关闭本窗口…%s' "${C_B}" "${C_N}"
  read -r _dummy_reply || true
fi
